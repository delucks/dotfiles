/**
 * User: delucks
 * Modified from the stock "sidebar" theme:
 * - Background color 1c1c1c -> 151515
 * - Cyan updated to orange
 * - Made background/foreground b&w
 */
* {
    text-color:  #000000;
    background-color:  #ffffff;
    dark: #000000;
    bgtrans: #ffffff;
    // Black
    black:       #3d352a;
    lightblack:  #554444;
    //
    // Red
    red:         #cd5c5c;
    lightred:    #cc5533;
    //
    // Green
    green:       #86af80;
    lightgreen:  #88cc22;
    //
    // Yellow
    yellow:      #e8ae5b;
    lightyellow:     #ffa75d;
    //
    // Blue
    blue:      #6495ed;
    lightblue:     #87ceeb;
    //
    // Magenta
    magenta:      #deb887;
    lightmagenta:     #996600;
    //
    // Cyan
    cyan:      #EA7D24;
    lightcyan:     #F79321;
    //
    // White
    white:      #ffffff;
    lightwhite:     #ddccbb;
    //
    // Bold, Italic, Underline
    highlight:     bold;
}
window {
    height:   100%;
    width: 40em;
    location: west;
    anchor:   west;
    border:  0px 2px 0px 0px;
    text-color: @lightblack;
}

mode-switcher {
    border: 2px 0px 0px 0px;
    background-color: @lightblack;
    padding: 4px;
}
button selected {
    border-color: @lightgreen;
    text-color: @lightblack;
}
inputbar {
    background-color: @lightblack;
    text-color: @lightgreen;
    padding: 4px;
    border: 0px 0px 2px 0px;
}
mainbox {
    expand: true;
    background-color: @bgtrans;
    spacing: 1em;
}
listview {
    padding: 0em 0.4em 0em 1em;
    dynamic: false;
    lines: 0;
}
element selected  normal {
    text-color: @lightblack;
}
element normal active {
    text-color: @lightblue;
}
element normal urgent {
    text-color: @lightred;
}
element alternate normal {
}
element alternate active {
    text-color: @lightblue;
}
element alternate urgent {
    text-color: @lightred;
}
element selected active {
    text-color: @lightblack;
}
element selected urgent {
    text-color: @lightblack;
}

error-message {
    expand: true;
    background-color: red;
    border-color: darkred;
    border: 2px;
    padding: 1em;
}
